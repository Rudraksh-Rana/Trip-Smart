# ML Service Environment Variables
# Copy this file to .env and fill in your values

# CORS - comma-separated list of allowed origins
# Use * for development, or specific domains for production
# e.g. https://tripsmart.vercel.app,https://tripsmart.railway.app
ALLOWED_ORIGINS=*

# No other secrets required for this service currently.
# Future integrations (e.g. external ML APIs) would go here.
